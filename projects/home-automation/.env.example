# ==========================================
# BARA-Sense Environment Configuration
# ==========================================

# Tuya IoT Platform Credentials (https://iot.tuya.com)
TUYA_ACCESS_ID=your_tuya_access_id
TUYA_ACCESS_KEY=your_tuya_access_key
TUYA_ENDPOINT=https://openapi-sg.iotbing.com

# Server Configuration
PORT=3000

# PostgreSQL Connection
# Jika menggunakan Docker Compose dengan service db:
POSTGRES_URL=postgres://postgres:postgres@db:5432/home_automation?sslmode=disable
# Atau jika menggunakan Postgres eksternal / Supabase:
# POSTGRES_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Cloudflare Tunnel (Opsional jika ingin otomatis online via tunnel)
CUSTOM_DOMAIN=bara-sense.my.id
CLOUDFLARE_TUNNEL_TOKEN=
